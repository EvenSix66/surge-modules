#!name=Google 搜索重定向
#!desc=将 Google 中国搜索域名跳转至 www.google.com，保留路径和搜索词。\n\n作者：EvenSix66（独立编写）\n归档：evenmodule · 2026.11.20.3\n语法依据：manual.nssurge.com/http/url-rewrite.html\nHTTPS 请求需启用重写与 MITM，并信任证书；请停用重复重定向模块。\n项目：https://github.com/EvenSix66/surge-modules
#!author=EvenSix66
#!homepage=https://github.com/EvenSix66/surge-modules
#!category=evenmodule
#!version=2026.11.20.3

# Independently written using https://manual.nssurge.com/http/url-rewrite.html
[URL Rewrite]
^https?://(?:www\.)?(?:google|g)\.cn(?=[:/?]|$)(?::\d+)?(.*)$ https://www.google.com$1 307

[MITM]
hostname = %APPEND% google.cn, www.google.cn, g.cn, www.g.cn
